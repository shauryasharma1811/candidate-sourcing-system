# Production environment for the frontend.
#
#   cp frontend/.env.production.example frontend/.env.production
#
# NEXT_PUBLIC_* variables are baked into the JS bundle at BUILD time, not
# read at container start — Dockerfile.prod takes this as a build ARG, so
# set it in CI/CD (GitHub Actions secret/variable) as well as here for
# local production builds.

# Same-origin: nginx proxies /api/* on the same domain to the backend, so
# the browser calls its own origin and never needs CORS at all in the
# common case. Only point this at a separate host (api.your-domain.com)
# if the backend is deployed on its own subdomain.
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com/api/v1
