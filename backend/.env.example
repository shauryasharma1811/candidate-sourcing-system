# --- App ---
APP_ENV=development
APP_NAME=Candidate Sourcing System
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg2://css_user:css_pass@db:5432/css_db
POSTGRES_USER=css_user
POSTGRES_PASSWORD=css_pass
POSTGRES_DB=css_db

# --- Auth ---
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- S3 / Uploads ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=resumes
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx
RESUME_DOWNLOAD_URL_TTL_SECONDS=300

# --- Virus scanning (placeholder — see app/services/virus_scan_service.py) ---
VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_PROVIDER=placeholder

# --- Retention policy ---
RESUME_RETENTION_DAYS=365

# --- Email (SMTP) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@candidatesourcing.local

# --- Frontend URL (used to build links embedded in outgoing emails, e.g.
# the password-reset link) ---
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Rate limiting (slowapi) — "N/unit" strings, e.g. "10/minute" ---
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute
RATE_LIMIT_RESUME_UPLOAD=10/minute

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
