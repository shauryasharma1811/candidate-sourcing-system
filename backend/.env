# --- App ---
APP_ENV=development
APP_NAME=Candidate Sourcing System
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg://css_user:css_pass@localhost:5432/css_db
POSTGRES_USER=css_user
POSTGRES_PASSWORD=css_pass
POSTGRES_DB=css_db

# --- Auth ---
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- S3 / Uploads ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=resumes
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx

# --- Email (SMTP) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@candidatesourcing.local

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
