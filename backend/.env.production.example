# Production environment for the backend.
#
#   cp backend/.env.production.example backend/.env.production
#
# Then fill in every value marked CHANGE_ME. Never commit the filled-in
# file — .env.production is (and must stay) gitignored. In CI/CD this
# file is generated from GitHub Actions/Secrets Manager, not checked in.

# --- App ---
APP_ENV=production
APP_NAME=Candidate Sourcing System
API_V1_PREFIX=/api/v1
DEBUG=false

# Comma-separated. Must be the exact scheme+host the frontend is served
# from — no trailing slash, no wildcards (CORSMiddleware doesn't support
# wildcard patterns, and allow_credentials=True forbids "*" anyway).
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- Database ---
# Use a strong, generated password — this also becomes POSTGRES_PASSWORD
# below, so the two must match exactly.
POSTGRES_USER=css_prod_user
POSTGRES_PASSWORD=CHANGE_ME_use_a_generated_32+_char_secret
POSTGRES_DB=css_db
DATABASE_URL=postgresql+psycopg2://css_prod_user:CHANGE_ME_use_a_generated_32+_char_secret@db:5432/css_db

# --- Auth ---
# Generate with: openssl rand -hex 32
# Rotating this invalidates every issued access/refresh token — treat it
# like a password, store it in a secrets manager, never in git.
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- S3 / Uploads ---
# Point at a managed provider (S3, Spaces, R2) in production rather than
# self-hosted MinIO where possible — one less stateful service to operate
# and back up. If using self-hosted MinIO, these must match the minio
# service's MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.prod.yml.
S3_ENDPOINT_URL=https://s3.your-region.amazonaws.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=css-prod-resumes
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx
RESUME_DOWNLOAD_URL_TTL_SECONDS=300

# --- Virus scanning ---
VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_PROVIDER=placeholder

# --- Retention policy ---
RESUME_RETENTION_DAYS=365

# --- Email (SMTP) ---
# Use a real transactional email provider (SES, Postmark, SendGrid, etc.)
# in production — not a catch-all/testing inbox like Mailtrap.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@your-domain.com
